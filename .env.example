# ---- JoltIQ configuration. Copy to .env. Generate real secrets with:  docker compose run --rm api python -m joltiq.cli gen-keys
# Product / branding (white-label: change these and per-tenant branding in Admin → Settings)
JOLTIQ_PRODUCT_NAME=JoltIQ
JOLTIQ_PRODUCT_DOMAIN=joltiq.io
JOLTIQ_SUPPORT_EMAIL=support@joltiq.io
NEXT_PUBLIC_PRODUCT_NAME=JoltIQ
NEXT_PUBLIC_SUPPORT_EMAIL=support@joltiq.io

# development | test | production (production refuses dev secrets & test fixtures)
JOLTIQ_ENV=development
JOLTIQ_WEB_ORIGIN=http://localhost:3000
JOLTIQ_API_PUBLIC_URL=http://localhost:8000
# OIDC stays disabled until an organization tests and enables a provider.
JOLTIQ_OIDC_ALLOWED_ISSUER_HOSTS=["login.microsoftonline.com"]
JOLTIQ_OIDC_HTTP_TIMEOUT_SECONDS=10
# true in production (HTTPS)
JOLTIQ_COOKIE_SECURE=false

# ---- Required secrets (production) ----
JOLTIQ_SECRET_KEY=
# Fernet key; encrypts integration/model credentials and MFA secrets
JOLTIQ_ENCRYPTION_KEY=
# HMAC key for approval grants
JOLTIQ_APPROVAL_SIGNING_KEY=
# ECDSA P-256 private key (PEM) signing envelopes to Windows companions
JOLTIQ_AGENT_SIGNING_KEY_PEM=
# shared bearer token API → browser worker
JOLTIQ_BROWSER_WORKER_TOKEN=
POSTGRES_PASSWORD=postgres
# password for the restricted, RLS-enforced joltiq_app role
JOLTIQ_APP_DB_PASSWORD=
MINIO_ROOT_USER=joltiq
MINIO_ROOT_PASSWORD=

# ---- AI providers (optional; tenants can also add their own keys in Admin → AI models) ----
JOLTIQ_OPENAI_API_KEY=
# Explicitly permit tenant-approved external models to receive computer screenshots and task context.
JOLTIQ_ALLOW_EXTERNAL_COMPUTER_USE_MODELS=false
# Optional self-hosted MeshCentral base URL shown to technicians. Leave blank to disable remote support.
# Local LAN acceptance example: https://192.168.0.56:8444 (replace with this server's stable address)
JOLTIQ_MESHCENTRAL_URL=
JOLTIQ_ANTHROPIC_API_KEY=
JOLTIQ_GEMINI_API_KEY=
# Customer-owned local multimodal gateway used for computer control.
JOLTIQ_OLLAMA_BASE_URL=http://host.docker.internal:11434
JOLTIQ_OLLAMA_MODEL=gemma3:4b
# deterministic test model when no provider is configured; MUST be false in production
JOLTIQ_ENABLE_LOCAL_FIXTURE_PROVIDERS=true

# ---- Live web research (one of) ----
JOLTIQ_BRAVE_SEARCH_API_KEY=
JOLTIQ_TAVILY_API_KEY=

# ---- Email (SMTP) ----
JOLTIQ_SMTP_HOST=mailpit
JOLTIQ_SMTP_PORT=1025
JOLTIQ_SMTP_USERNAME=
JOLTIQ_SMTP_PASSWORD=
JOLTIQ_SMTP_STARTTLS=false
JOLTIQ_EMAIL_FROM=no-reply@joltiq.io

# ---- Billing (Stripe). Test keys only until JOLTIQ_STRIPE_LIVE_MODE_AUTHORIZED=true ----
JOLTIQ_STRIPE_SECRET_KEY=
JOLTIQ_STRIPE_WEBHOOK_SECRET=
JOLTIQ_STRIPE_LIVE_MODE_AUTHORIZED=false

# ---- Observability ----
# e.g. http://otel-collector:4318/v1/traces
JOLTIQ_OTEL_EXPORTER_ENDPOINT=
