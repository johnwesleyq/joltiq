<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- DEV/TEST ONLY: Linux headless host of the companion. Runs the REAL JoltIQ.Agent.Core (enrollment, ES256 request
       signing, envelope verification, replay guard, local policy, journal) against the real API, with the SIMULATED OS
       from JoltIQ.Agent.Simulator instead of Windows. Never shipped to customers. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>JoltIQ.Agent.Headless</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\JoltIQ.Agent.Core\JoltIQ.Agent.Core.csproj" />
    <InternalsVisibleTo Include="JoltIQ.Agent.Core.Tests" />
  </ItemGroup>
</Project>

